# TWILIO_ACCOUNT_SID: Your Twilio Account SID.
# TWILIO_AUTH_TOKEN: Your Twilio Auth Token.
# TWILIO_PHONE_NUMBER: Your Twilio phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_TO_NUMBER=+918589878253

# GOOGLE_MAPS_API_KEY: Your Google Maps API key.
GOOGLE_MAPS_API_KEY=

# GEMINI API KEY
GEMINI_API_KEY=

# Optional runtime defaults
PORT=3000
PUBLIC_BASE_URL=
MOCK_MODE=true
TARGET_QUOTES=4
MAX_VENDOR_CALLS=8
TWILIO_MAX_TURNS=4
TWILIO_VOICE_MODE=live_stream
TWILIO_VALIDATE_SIGNATURES=true
QUOTE_CONFIDENCE_THRESHOLD=0.55
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE_NAME=Aoede
GEMINI_LIVE_PREFLIGHT_TIMEOUT_MS=5000
GEMINI_LIVE_PREFLIGHT_CACHE_MS=20000
AGENT_HUMAN_NAME=Alex Morgan
QUESTIONNAIRE_REQUIRE_AI=true
